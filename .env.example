# Anchor Memory 环境变量配置
# 复制为 .env 后修改：cp .env.example .env

# ── Embedding 模型 ──
# 格式: provider/model  留空则使用本地 sentence-transformers
#   local/paraphrase-multilingual-MiniLM-L12-v2    本地模型（默认，零 API 费用）
#   openai/text-embedding-3-small                   OpenAI 官方
#   openai-compat/text-embedding-3-small            兼容 OpenAI 的第三方（需配 ENDPOINT）
ANCHOR_EMBEDDING=
# API 模式时的密钥（openai / openai-compat 必填）
ANCHOR_EMBEDDING_API_KEY=
# API 模式时的自定义端点（openai-compat 时填写，如 https://api.deepseek.com/v1）
ANCHOR_EMBEDDING_ENDPOINT=

# ── Dashboard ──
# 纯数字密码，留空则 Dashboard 无需密码
ANCHOR_DASHBOARD_PASSWORD=

# ── MCP Server ──
ANCHOR_API_KEY=
ANCHOR_TRANSPORT=streamable-http
ANCHOR_PORT=8000

# ── LLM 配置（config.yaml 未配置时的 fallback）──
# 为空则后台LLM功能降级为粗匹配
ANCHOR_LLM=openai-compat/deepseek-v4-flash
ANCHOR_LLM_API_KEY=
ANCHOR_LLM_ENDPOINT=https://api.deepseek.com/v1
